{
  "name": "tarja",
  "version": "0.1.0",
  "private": true,
  "description": "Raio-X de LGPD para schemas SQL. Roda no navegador, sem backend.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/gerar-csp.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:slow": "vitest run --config vitest.slow.config.ts --coverage",
    "test:all": "npm test && npm run test:slow",
    "corpus:metrics": "tsx scripts/corpus-metrics.ts",
    "corpus:validacao": "tsx scripts/corpus-metrics.ts --validacao",
    "corpus:externo": "tsx scripts/corpus-metrics.ts --externo",
    "freeze:validacao": "tsx scripts/freeze-validation.ts",
    "corpus:fetch": "tsx scripts/fetch-external.ts",
    "pretest:slow": "npm run corpus:fetch",
    "corpus:validacao-v2": "tsx scripts/corpus-metrics.ts --validacao-v2",
    "corpus:externo-v2": "tsx scripts/corpus-metrics.ts --externo-v2",
    "doc:padroes": "tsx scripts/gerar-doc-padroes.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
